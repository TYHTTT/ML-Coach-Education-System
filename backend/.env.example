# 运行环境：development、test 或 production；生产环境会启用更严格的安全校验。
APP_ENV=development
# FastAPI 监听地址；0.0.0.0 允许局域网或容器访问。
APP_HOST=0.0.0.0
# FastAPI 监听端口，范围为 1 到 65535。
APP_PORT=8000
# 应用日志级别，例如 DEBUG、INFO、WARNING 或 ERROR。
APP_LOG_LEVEL=INFO

# 允许访问 API 的前端地址；多个地址用英文逗号分隔。
FRONTEND_ORIGIN=http://localhost:3000

# 已发布 Dify 应用的 Service API 地址（包含 /v1）。
# 自建实例示例：http://localhost/v1；不要填 WebApp 分享链接。
DIFY_API_BASE_URL=https://api.dify.ai/v1
# 应用 API Key，仅保存在后端；不要使用知识库 API Key。
DIFY_API_KEY=
# 单次请求超时（秒），模型、提示词和检索策略在 Dify 配置。
DIFY_TIMEOUT_SECONDS=120
# 额外输入变量，JSON 对象；course、topic_id 由后端传入。
# 自由问答不传课程和知识点，Dify 中这两个变量需允许省略。
DIFY_INPUTS={}

# postgresql://[用户名]:[密码]@[主机]:[端口]/[数据库名]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ml_coach

# 创建管理员的授权码；仅由后端校验。留空时禁止创建管理员，不影响已有管理员登录。
# 请设置独立的随机值，不要使用 Dify 密钥，也不要添加 NEXT_PUBLIC_ 前缀。
ADMIN_AUTHCODE=

# 单条用户消息允许的最大字符数。
MAX_HISTORY_MESSAGES=12
# 单条用户消息允许的最大字符数。
MAX_MESSAGE_LENGTH=8000
