# 运行环境：development、test 或 production。
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# 允许访问 API 的前端地址；多个地址用英文逗号分隔。
FRONTEND_ORIGIN=http://localhost:3000

# 已发布 Dify 应用的 Service API 地址（包含 /v1）。
# 自建实例示例：http://localhost/v1；不要填 WebApp 分享链接。
DIFY_API_BASE_URL=https://api.dify.ai/v1
# 应用 API Key，仅保存在后端；不要使用知识库 API Key。
DIFY_API_KEY=
# 单次请求超时（秒），模型、提示词和检索策略在 Dify 配置。
DIFY_TIMEOUT_SECONDS=120
# 额外输入变量，JSON 对象；course、topic_id 由后端传入。
# 自由问答不传课程和知识点，Dify 中这两个变量需允许省略。
DIFY_INPUTS={}

# PostgreSQL 保存账户、课程目录、学习状态及已有历史成绩。
# 问答、出题和评价均由 Dify 负责，不需要 pgvector。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ml_coach

# 仅在 Dify 未返回会话 ID 时，使用近期对话补充上下文。
MAX_HISTORY_MESSAGES=12
MAX_MESSAGE_LENGTH=8000

# 以下参数仅供课程概览读取旧评估记录、计算历史推荐使用。
# 当前 Agent 对话不执行本地评分或掌握度更新，也不据此限制学习。
MASTERY_GATE_THRESHOLD=0.80
PREREQUISITE_MASTERY_THRESHOLD=0.80
MASTERY_MIN_VALID_ATTEMPTS=3
MASTERY_CHECKPOINT_SCORE=80
MASTERY_MIN_DIMENSION_COVERAGE=3
